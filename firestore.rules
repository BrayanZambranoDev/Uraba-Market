rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    // Solo los campos dados fueron modificados
    function onlyFields(fields) {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(fields);
    }
    // El campo cambiado está dentro del conjunto permitido
    function onlySubsetOf(fields) {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(fields)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(fields);
    }

    // ── Usuarios ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isOwner(userId);

      // Favoritos — solo el dueño
      match /favoritos/{favId} {
        allow read, write: if isOwner(userId);
      }

      // Siguiendo vendedores — solo el dueño puede seguir/dejar de seguir
      match /siguiendo/{sellerId} {
        allow read, write: if isOwner(userId);
      }

      // Historial de conversaciones con Ura IA — solo el dueño
      match /ai_historial/{convId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // ── Productos ─────────────────────────────────────────────────
    match /productos/{productId} {
      allow read: if true;

      allow create: if isAuth()
        && request.resource.data.vendedorId == request.auth.uid;

      allow update: if isAuth()
        && (
          // El propio vendedor puede editar todo
          resource.data.vendedorId == request.auth.uid
          // CartService descuenta stock al comprar
          || onlyFields(['stock'])
          // Sistema de calificaciones actualiza promedios
          || onlyFields(['ratingAvg', 'ratingCount'])
          // Contador de vistas (best-effort, cualquier auth)
          || onlyFields(['vistas'])
        );

      allow delete: if isAuth()
        && resource.data.vendedorId == request.auth.uid;

      // ── Calificaciones ─────────────────────────────────────────
      match /calificaciones/{calId} {
        allow read: if true;
        allow create: if isAuth()
          && request.resource.data.compradorId == request.auth.uid;
        allow update, delete: if isAuth()
          && resource.data.compradorId == request.auth.uid;
      }

      // ── Preguntas al vendedor ──────────────────────────────────
      match /preguntas/{pregId} {
        allow read: if isAuth();

        // Solo el comprador crea su pregunta (sin respuesta previa)
        allow create: if isAuth()
          && request.resource.data.compradorId == request.auth.uid
          && request.resource.data.respuesta == null;

        // Solo alguien distinto al que preguntó puede responder,
        // y únicamente puede modificar respuesta + fechaRespuesta
        allow update: if isAuth()
          && resource.data.compradorId != request.auth.uid
          && onlySubsetOf(['respuesta', 'fechaRespuesta']);

        // El autor de la pregunta puede eliminarla si no tiene respuesta
        allow delete: if isAuth()
          && resource.data.compradorId == request.auth.uid
          && resource.data.respuesta == null;
      }
    }

    // ── Pedidos ───────────────────────────────────────────────────
    match /pedidos/{orderId} {
      // get individual: solo participantes
      allow get: if isAuth()
        && (resource.data.compradorId == request.auth.uid
            || resource.data.vendedorId == request.auth.uid);
      // list/query: cualquier auth (las queries filtran por compradorId o vendedorId)
      allow list: if isAuth();

      allow create: if isAuth()
        && request.resource.data.compradorId == request.auth.uid;

      allow update: if isAuth()
        && (resource.data.compradorId == request.auth.uid
            || resource.data.vendedorId == request.auth.uid);

      // Historial de estados — solo participantes del pedido
      match /historial/{entradaId} {
        allow read: if isAuth()
          && (get(/databases/$(database)/documents/pedidos/$(orderId))
                .data.compradorId == request.auth.uid
              || get(/databases/$(database)/documents/pedidos/$(orderId))
                   .data.vendedorId == request.auth.uid);
        // La app crea entradas al cambiar estado; cualquier auth puede crear
        // (la verificación real está en las reglas del pedido padre)
        allow create: if isAuth();
      }
    }

    // ── Publicaciones (Feed) ──────────────────────────────────────
    match /publicaciones/{postId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && request.resource.data.autorId == request.auth.uid;

      // El autor edita su publicación completa;
      // cualquier auth solo puede modificar likes y comentariosCount
      allow update: if isAuth()
        && (resource.data.autorId == request.auth.uid
            || onlySubsetOf(['likes', 'comentariosCount']));

      allow delete: if isAuth()
        && resource.data.autorId == request.auth.uid;

      match /comentarios/{comentarioId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.autorId == request.auth.uid;
        allow delete: if isAuth()
          && resource.data.autorId == request.auth.uid;
      }
    }

    // ── Carrito ───────────────────────────────────────────────────
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Reportes ─────────────────────────────────────────────────
    match /reportes/{reporteId} {
      allow read: if false; // Solo admin
      allow create: if isAuth()
        && request.resource.data.reporterId == request.auth.uid;
    }

    // ── Movimientos de stock ────────────────────────────────────
    match /productos/{productId}/stockMovements/{movId} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    // ── Conversaciones ────────────────────────────────────────────
    match /conversations/{convId} {
      allow read, update: if isAuth()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participantIds;

      match /messages/{msgId} {
        allow read, write: if isAuth()
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId))
               .data.participantIds;
      }
    }
  }
}
